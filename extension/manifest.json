{
  "manifest_version": 3,
  "name": "GitHub Image Viewer",
  "version": "1.0.0",
  "description": "Open images in GitHub issues, PRs, comments and READMEs in an in-page viewer with arrows, zoom, rotate, copy and download.",
  "homepage_url": "https://github.com/AyushKaithwas/github-image-viewer",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://gist.github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
