{
  "name": "github-image-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension: view GitHub images in a fast in-page viewer instead of a new tab.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "setup": "playwright install chromium",
    "test": "node tests/e2e.mjs && node tests/downloads.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:downloads": "node tests/downloads.mjs",
    "test:live": "node tests/live.mjs",
    "icons": "node scripts/make-icons.mjs",
    "demo": "node scripts/record-demo.mjs",
    "package": "rm -f github-image-viewer.zip && cd extension && zip -r -X ../github-image-viewer.zip . -x '.*' '*/.*'",
    "store-assets": "node scripts/make-store-assets.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
